# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard → Project Settings → API / Database.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose these to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection used by Drizzle (server only).
# Use the "Transaction pooler" connection string (port 6543) for the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Use the "Session pooler" or direct connection string (port 5432) for migrations.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Private Storage bucket for supplier documents (created by `npm run setup`)
SUPABASE_DOCUMENTS_BUCKET=supplier-documents

# Base URL of the app, used in supplier registration links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First administrator, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=System Administrator

# ─── Outgoing email (supplier requests, reminders, registration links) ───
# Leave SMTP_HOST empty to keep emails in the in-app Outbox instead of sending them.
# Microsoft 365: smtp.office365.com, port 587 (IT must enable "Authenticated SMTP" for the mailbox).
# Google Workspace: smtp.gmail.com, port 587 with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to suppliers, e.g. "Oracle Petroleum Purchasing <purchasing@oraclepetroleum.net>"
SMTP_FROM=
# Optional: "true" forces TLS from the start (port 465). Port 587 upgrades automatically.
SMTP_SECURE=

# Secret for the hourly reminder job: GET /api/cron/requests with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
